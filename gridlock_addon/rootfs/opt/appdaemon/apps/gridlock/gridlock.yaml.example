gridlock:
  module: gridlock
  class: GridLock

  # --- Hardware (Sigenergy) ---
  sigen_mode: select.sigen_plant_remote_ems_control_mode
  sigen_discharge_limit: number.sigen_plant_ess_max_discharging_limit
  sigen_charge_limit: number.sigen_plant_ess_max_charging_limit
  sigen_soc: sensor.sigen_inverter_battery_state_of_charge

  # --- Inputs ---
  # ev_charging: switch.hypervolt_xxxxx_charging  # only if auto-discovery
  #   guesses wrong or you don't use a Hypervolt charger — the engine
  #   looks for a "switch." entity with "hypervolt" + "charging" in its
  #   entity_id first, so this is usually not needed.

  # Octopus (BottlecapDave integration) entities are auto-discovered
  # at startup by naming pattern, since your account/MPAN is baked
  # into the entity_id itself — nothing to configure here for a single
  # Octopus account/electricity meter. Check the AppDaemon log for
  # "Multiple entities match" warnings if you have more than one
  # account/meter and discovery picks the wrong one; only then set the
  # affected key explicitly below as a literal value (NOT !secret —
  # AppDaemon's app-config loader has no built-in secrets.yaml/!secret
  # support the way HA core does; using it here breaks the whole file):
  # octopus_dispatch: binary_sensor.octopus_energy_a_XXXXXXXX_intelligent_dispatching
  # import_rate: sensor.octopus_energy_electricity_XXXXXXXX_1111111111111_current_rate
  # export_rate: sensor.octopus_energy_electricity_XXXXXXXX_2222222222222_export_current_rate
  # octopus_saving_events: event.octopus_energy_a_XXXXXXXX_octoplus_saving_session_events
  # import_rates_previous / import_rates_today / import_rates_tomorrow
  # export_rates_today / export_rates_tomorrow
  # daily_import_cost_entity / daily_standing_charge_entity

  # No Octopus naming convention for solar export value — set this if
  # you track it (varies by inverter integration):
  daily_export_value_entity: sensor.solar_export_value_today_numeric

  # Solcast half-hourly curves
  solcast_detail_today: sensor.solcast_pv_forecast_forecast_today
  solcast_detail_tomorrow: sensor.solcast_pv_forecast_forecast_tomorrow

  # --- Model parameters ---
  battery_capacity_kwh: 36.0
  typical_daily_house_kwh: 12.0
  inverter_efficiency: 0.90
  battery_degradation_cost: 0.03      # £/kWh discharged
  floor_soc: 10
  charge_rate_kw: 10.0
  discharge_rate_kw: 10.0
  ev_concurrent_charge_kw: 5.0        # battery charge rate while Hypervolt active
  default_import_rate: 0.2839
  default_export_rate: 0.15
  export_margin: 0.02
  # Optional: 24 hourly load weights (relative). Uncomment to shape load:
  # load_hourly_weights: [2,2,2,2,2,2,4,6,5,4,4,4,4,4,4,5,7,9,9,8,6,5,4,3]

  # --- Tariff comparison ([REDACTED]-Compare style) ---
  compare_tariffs:
    - name: "Octopus Go"
      import_default: 0.2662
      import: [{ start: "00:30", end: "05:30", rate: 0.085 }]
      export: 0.15
    - name: "Flexible (SVT)"
      import_default: 0.2703
      export: 0.15
    - name: "Cosy Octopus"
      import_default: 0.2634
      import:
        - { start: "04:00", end: "07:00", rate: 0.1289 }
        - { start: "13:00", end: "16:00", rate: 0.1289 }
        - { start: "16:00", end: "19:00", rate: 0.3595 }
        - { start: "22:00", end: "00:00", rate: 0.1289 }
      export: 0.15
    - name: "E7"
      import_default: 0.2950
      import: [{ start: "00:30", end: "07:30", rate: 0.13 }]
      export: 0.04

  # --- Storm Watch ---
  # Charge to target and hold (no exports) while a weather alert is active.
  # Works with MeteoAlarm (HA core integration, uses Met Office feed for UK):
  storm_watch_entity:
    - entity: binary_sensor.meteoalarm      # Met Office red warnings only
      severity: ["Extreme"]
  storm_watch_target_soc: 100
  # SSEN Power Track — polled directly by the engine, no HA sensors needed.
  # Postcode prefix (outward code + first digit of inward code, e.g.
  # "SW1A 1") — literal value (see note above re: !secret not working
  # here). Leave commented out to disable SSEN polling.
  # ssen_postcode: "SW1A 1"

  # --- Self-updater (optional; not needed via the Supervisor add-on,
  #     which handles updates through the HA UI instead) ---
  # Fine-grained PAT with Contents:Read on this repo only — use a
  # separate read-only token from anything with write access. Literal
  # value only (!secret doesn't work in this file — see note above).
  # update_repo: "james-autho-tech/gridlock"
  # update_token: "github_pat_..."
  # update_branch: main
  # update_path: apps/gridlock/gridlock.py
  # auto_update: false   # true = pull + hot-reload automatically
