#!/usr/bin/with-contenv bashio
# ==============================================================================
# Starts GridLock's bundled AppDaemon instance.
# ==============================================================================

CONFIG_DIR=/config

mkdir -p "${CONFIG_DIR}/apps/gridlock"

if [ ! -f "${CONFIG_DIR}/apps/gridlock/gridlock.yaml" ]; then
    bashio::log.info "No gridlock.yaml in addon_config yet — copying the template."
    bashio::log.warning "Edit ${CONFIG_DIR}/apps/gridlock/gridlock.yaml and ${CONFIG_DIR}/secrets.yaml before trusting the plan."
    cp /opt/appdaemon/apps/gridlock/gridlock.yaml.example "${CONFIG_DIR}/apps/gridlock/gridlock.yaml"
fi

if [ ! -f "${CONFIG_DIR}/secrets.yaml" ]; then
    touch "${CONFIG_DIR}/secrets.yaml"
fi

# gridlock.py always comes from the image (update by installing a new
# add-on version), gridlock.yaml/secrets.yaml persist in addon_config.
cp /opt/appdaemon/apps/gridlock/gridlock.py "${CONFIG_DIR}/apps/gridlock/gridlock.py"

# AppDaemon requires latitude/longitude/elevation/time_zone up front —
# pull them from HA core's own config via the Supervisor API proxy
# rather than hardcoding, with a short retry in case core isn't ready.
python3 - "${CONFIG_DIR}" <<'PYEOF'
import json
import os
import sys
import time
import urllib.error
import urllib.request

config_dir = sys.argv[1]
token = os.environ["SUPERVISOR_TOKEN"]
req = urllib.request.Request(
    "http://supervisor/core/api/config",
    headers={"Authorization": f"Bearer {token}"})

core = None
for attempt in range(12):
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            core = json.load(resp)
        break
    except (urllib.error.URLError, TimeoutError) as exc:
        print(f"Waiting for HA core API ({exc})...", file=sys.stderr)
        time.sleep(5)

if core is None:
    print("Could not reach HA core API after 60s", file=sys.stderr)
    sys.exit(1)

appdaemon_yaml = f"""appdaemon:
  latitude: {core['latitude']}
  longitude: {core['longitude']}
  elevation: {core['elevation']}
  time_zone: {core['time_zone']}
  plugins:
    HASS:
      type: hass
      ha_url: http://supervisor/core
      token: {token}
"""
with open(os.path.join(config_dir, "appdaemon.yaml"), "w") as f:
    f.write(appdaemon_yaml)
PYEOF
if [ $? -ne 0 ]; then
    bashio::log.error "Failed to fetch HA core config — cannot start AppDaemon."
    exit 1
fi

bashio::log.info "Starting AppDaemon..."
cd "${CONFIG_DIR}" || exit 1
exec appdaemon -c "${CONFIG_DIR}"
