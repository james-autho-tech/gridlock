gridlock:
  module: gridlock
  class: GridLock

  # --- Hardware (Sigenergy) ---
  sigen_mode: select.sigen_plant_remote_ems_control_mode
  sigen_discharge_limit: number.sigen_plant_ess_max_discharging_limit
  sigen_charge_limit: number.sigen_plant_ess_max_charging_limit
  sigen_soc: sensor.sigen_inverter_battery_state_of_charge

  # --- Inputs ---
  # ev_charging: switch.hypervolt_xxxxx_charging  # only if auto-discovery
  #   guesses wrong or you don't use a Hypervolt charger — the engine
  #   looks for a "switch." entity with "hypervolt" + "charging" in its
  #   entity_id first, so this is usually not needed.

  # Octopus (BottlecapDave integration) entities are auto-discovered
  # at startup by naming pattern, since your account/MPAN is baked
  # into the entity_id itself — nothing to configure here for a single
  # Octopus account/electricity meter. Check the AppDaemon log for
  # "Multiple entities match" warnings if you have more than one
  # account/meter and discovery picks the wrong one; only then set the
  # affected key explicitly below as a literal value (NOT !secret —
  # AppDaemon's app-config loader has no built-in secrets.yaml/!secret
  # support the way HA core does; using it here breaks the whole file):
  # octopus_dispatch: binary_sensor.octopus_energy_a_XXXXXXXX_intelligent_dispatching
  # import_rate: sensor.octopus_energy_electricity_XXXXXXXX_1111111111111_current_rate
  # export_rate: sensor.octopus_energy_electricity_XXXXXXXX_2222222222222_export_current_rate
  # octopus_saving_events: event.octopus_energy_a_XXXXXXXX_octoplus_saving_session_events
  # import_rates_previous / import_rates_today / import_rates_tomorrow
  # export_rates_today / export_rates_tomorrow
  # daily_import_cost_entity / daily_standing_charge_entity /
  # daily_export_value_entity — check the Discovered Entities panel
  # first; if it's wrong/missing, set it here or via the add-on's
  # Configuration tab (daily_export_value_entity_override). Either way
  # GridLock also tracks its own running import/export total from live
  # grid power + rates as a fallback, so "Today net" never silently
  # ignores export credit even with nothing configured — see the
  # tooltip on that tile for the calculated figure.
  # daily_export_value_entity: sensor.octopus_energy_electricity_XXXXXXXX_2222222222222_current_accumulative_cost

  # Solcast half-hourly curves
  solcast_detail_today: sensor.solcast_pv_forecast_forecast_today
  solcast_detail_tomorrow: sensor.solcast_pv_forecast_forecast_tomorrow

  # House load: auto-discovered (a "sensor." entity containing "sigen"
  # + "load"/"consumption") and learned into a per-half-hour-of-day
  # profile over time — see load_hourly_weights below for the fallback
  # used before enough data's been learned. Override only if discovery
  # picks the wrong sensor or your inverter integration isn't Sigen:
  # load_power_entity: sensor.sigen_plant_load_power

  # --- Model parameters ---
  battery_capacity_kwh: 36.0
  typical_daily_house_kwh: 12.0
  inverter_efficiency: 0.90
  # Three real operational modes for the LP optimiser (core/optimizer.py),
  # not just a degradation-cost scalar under one shared behaviour:
  #   eco         — battery never exports (only direct solar surplus can);
  #                 optimises purely for minimal import cost.
  #   balanced     — exports allowed, but only slots where the LP finds
  #                 export_rate - import_rate/efficiency actually clears
  #                 the degradation cost below get sold; the default.
  #   max_profit    — degradation cost forced to 0; sells any margin above
  #                 round-trip cost, preserving only enough SoC for
  #                 forecasted load until the next off-peak slot.
  # Check the Forecast tab's Battery health panel for the SoH sensors
  # that motivated the degradation-cost lever, and its current effective
  # £/kWh threshold under whichever mode you pick. Not a real
  # degradation-vs-cycling model (no solid data to build one from), just
  # a sensible lever to have.
  battery_risk_profile: balanced      # eco | balanced | max_profit
  # battery_degradation_cost: 0.03    # £/kWh — overrides the mode's default above if set
  # Optional (balanced mode only): once today's cumulative real grid
  # cost drops to/below this £ figure, stop exporting for the rest of
  # today (tomorrow gets its own fresh budget). Unset by default — the
  # LP just keeps selling wherever it's profitable all day.
  # target_daily_net_cost: 0.0
  # Extra slack the on-peak reserve holds back on top of the bare
  # forecasted load for the rest of a peak stretch — 0.15 means "reserve
  # for 115% of predicted load", not exactly 100% of it. Matters because
  # the plan re-solves every 5 minutes and can't claw back charge an
  # earlier slot already exported/discharged: if the learned load
  # forecast for a later slot drifts upward after an earlier one has
  # already sold against the old, lower estimate, that's gone — only a
  # margin held back in advance protects against it. Raise this if
  # you're seeing Bypass slots you don't think should've happened; lower
  # it (toward 0) to squeeze closer to the theoretical maximum if your
  # load is very predictable and you'd rather have the extra export.
  reserve_margin_pct: 0.15
  # Reserve the plan won't discharge below, even if profitable. Default
  # 0 uses the full battery; raise this if you'd rather keep a buffer
  # against deep-discharge wear — most general battery guidance
  # suggests some margin, but that's a preference, not enforced here.
  floor_soc: 0
  charge_rate_kw: 10.0
  discharge_rate_kw: 10.0
  ev_concurrent_charge_kw: 5.0        # battery charge rate while Hypervolt active
  default_import_rate: 0.2839
  default_export_rate: 0.15
  export_margin: 0.02
  # Import rate at/below which a slot counts as "off-peak" for pacing
  # self-consumption toward the next cheap window, and as the hard
  # floor for grid-charging (charging above this, arbitrage math
  # aside, never happens except Storm Watch).
  cheap_rate_threshold: 0.10
  # Smallest export worth bothering with, as % of battery capacity —
  # a lone slot selling a fraction of a percent isn't worth the SoC
  # it spends even if it technically shaves a fraction of a penny off
  # cost. Blocks aren't split up to satisfy this — only a whole
  # contiguous export block below the threshold gets dropped back to
  # self-consumption; a genuinely good export window is untouched.
  min_export_pct: 5.0
  # Superseded as of the LP optimiser (v3.0.0): the LP always paces
  # battery use optimally across the whole horizon on its own — there's
  # no longer an "immediate spend vs ration" choice to make by hand, the
  # solver finds whichever is actually cheapest. Left parseable (logged,
  # not an error) so an existing apps.yaml with this set doesn't break;
  # it just no longer changes behaviour.
  # conserve_battery_for_peak: false
  # Max rate EXPORT is allowed to sell at, per slot - separate from
  # discharge_rate_kw (self-consumption still uses the full hardware
  # rate for real load). Defaults to discharge_rate_kw (no change).
  # Lowering it spreads the same volume across more slots for a
  # gentler peak discharge current - but it's a real financial
  # tradeoff, not a free win: the good export window is only ever so
  # many slots long, and once it runs out of slots to spread into,
  # less total volume gets sold at a good rate. Tested at half rate on
  # a real evening window: ~24% less profit, not "the same money".
  # export_rate_kw: 10.0
  # Optional: 24 hourly load weights (relative), used only for slots
  # the learned load profile above doesn't have data for yet:
  # load_hourly_weights: [2,2,2,2,2,2,4,6,5,4,4,4,4,4,4,5,7,9,9,8,6,5,4,3]

  # --- Tariff comparison ---
  compare_tariffs:
    - name: "Octopus Go"
      import_default: 0.2662
      import: [{ start: "00:30", end: "05:30", rate: 0.085 }]
      export: 0.15
    - name: "Flexible (SVT)"
      import_default: 0.2703
      export: 0.15
    - name: "Cosy Octopus"
      import_default: 0.2634
      import:
        - { start: "04:00", end: "07:00", rate: 0.1289 }
        - { start: "13:00", end: "16:00", rate: 0.1289 }
        - { start: "16:00", end: "19:00", rate: 0.3595 }
        - { start: "22:00", end: "00:00", rate: 0.1289 }
      export: 0.15
    - name: "E7"
      import_default: 0.2950
      import: [{ start: "00:30", end: "07:30", rate: 0.13 }]
      export: 0.04

  # --- Storm Watch ---
  # Charge to target and hold (no exports) while a weather alert is active.
  # Works with MeteoAlarm (HA core integration, uses Met Office feed for UK):
  storm_watch_entity:
    - entity: binary_sensor.meteoalarm      # Met Office red warnings only
      severity: ["Extreme"]
  storm_watch_target_soc: 100
  # SSEN Power Track — polled directly by the engine, no HA sensors needed.
  # Postcode prefix (outward code + first digit of inward code, e.g.
  # "SW1A 1") — literal value (see note above re: !secret not working
  # here). Leave commented out to disable SSEN polling.
  # ssen_postcode: "SW1A 1"

  # --- Notifications ---
  # Storm Watch starting/clearing, a Saving Session being joined, and
  # EV Protection engaging always create a persistent_notification in
  # HA (Settings > Notifications) — no setup needed. Optionally also
  # send to a specific notify service (e.g. your phone):
  # notify_service: notify.mobile_app_yourphone

  # --- Battery health (Forecast tab) ---
  # Auto-discovered by default (Sigenergy "pcs"/"cell"/
  # "state_of_health" sensors) — only set these if the Discovered
  # Entities panel shows the wrong one, or you're not on Sigenergy
  # hardware:
  # inverter_temp_entity: sensor.sigen_inverter_pcs_internal_temperature
  # battery_temp_entity: sensor.sigen_plant_ess_average_cell_temperature
  # battery_soh_entity: sensor.sigen_plant_battery_state_of_health
  #
  # Not just informational: once inverter_temp_entity reads above 60°C,
  # every charge/discharge command GridLock sends gets scaled down
  # (linear taper to 25% by 75°C) — an extra safety margin on top of
  # whatever thermal protection the inverter has built in already
  # (unverified what that is). No setting to disable this currently.

  # Hardware-level backstop for floor_soc — auto-discovered
  # (number.sigen_plant_ess_discharge_cut_off_state_of_charge), kept in
  # sync with floor_soc automatically. Without this, floor_soc only
  # ever existed in GridLock's own planning, with no hardware-level
  # stop if the tick loop ever hung mid-command. Override if discovery
  # picks the wrong one:
  # discharge_cutoff_entity: number.sigen_plant_ess_discharge_cut_off_state_of_charge
