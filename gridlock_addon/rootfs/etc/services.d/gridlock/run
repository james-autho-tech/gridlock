#!/usr/bin/with-contenv bashio
# ==============================================================================
# Starts GridLock's bundled AppDaemon instance.
# ==============================================================================

CONFIG_DIR=/config

# The add-on's config.yaml version is the single source of truth —
# gridlock.py reads it via this env var instead of keeping its own
# separate VERSION constant that has to be bumped in sync by hand.
export GL_VERSION="$(bashio::addon.version 2>/dev/null)" || true

mkdir -p "${CONFIG_DIR}/apps/gridlock"

GL_YAML="${CONFIG_DIR}/apps/gridlock/apps.yaml"

if [ ! -f "$GL_YAML" ]; then
    bashio::log.info "No apps.yaml in addon_config yet — copying the template."
    bashio::log.warning "Edit ${GL_YAML} before trusting the plan."
    cp /opt/appdaemon/apps/gridlock/apps.yaml.example "$GL_YAML"
else
    # Self-heal: AppDaemon silently fails to load the whole app if this
    # file doesn't parse (e.g. an unsupported !secret tag), with no
    # obvious error pointing at why nothing gets published. Validate it
    # ourselves first so a broken file can't sit there forever.
    # bashio sets `set -o errexit`, so a non-zero exit from this command
    # substitution would silently kill the whole script right here —
    # `|| true` neutralises that; $YAML_ERR itself carries the result.
    YAML_ERR="$(python3 -c "
import sys, yaml
try:
    yaml.safe_load(open('$GL_YAML'))
except Exception as exc:
    print(exc)
    sys.exit(1)
" 2>&1)" || true
    if [ -n "$YAML_ERR" ]; then
        bashio::log.error "apps.yaml failed to parse: ${YAML_ERR}"
        bashio::log.error "Backing it up to apps.yaml.broken and restoring the template so the engine can start — re-apply your entity IDs to the fresh copy."
        cp "$GL_YAML" "${GL_YAML}.broken"
        cp /opt/appdaemon/apps/gridlock/apps.yaml.example "$GL_YAML"
    fi
fi

if [ ! -f "${CONFIG_DIR}/secrets.yaml" ]; then
    touch "${CONFIG_DIR}/secrets.yaml"
fi

# gridlock.py and its core/ package always come from the image (update
# by installing a new add-on version); apps.yaml/secrets.yaml and the
# persisted state JSON files persist in addon_config. core/ has to be
# copied as a tree, not just the one file, now that the optimiser/
# adapters/providers live in that package alongside gridlock.py.
cp /opt/appdaemon/apps/gridlock/gridlock.py "${CONFIG_DIR}/apps/gridlock/gridlock.py"
rm -rf "${CONFIG_DIR}/apps/gridlock/core"
cp -r /opt/appdaemon/apps/gridlock/core "${CONFIG_DIR}/apps/gridlock/core"

# The fail-safe watchdog automation (+ the enable/mode-override
# helpers) has to live in HA core, not AppDaemon — the whole point is
# surviving AppDaemon itself hanging or dying, so it can't depend on
# anything AppDaemon-side to install or apply it. Previously this
# required the user to manually copy ha_support.yaml into
# /config/packages/ and restart HA core themselves — easy to skip
# entirely, or to silently drift out of date against what a newer
# add-on version ships. Write/refresh it automatically instead, same
# "shipped file, reset from the image every start" treatment already
# used for gridlock.py/core above (not something to hand-edit — it
# takes no user-specific values). Needs the homeassistant_config:rw
# map entry in config.yaml, mounted here at /homeassistant_config.
HA_CONFIG_DIR=/homeassistant_config
if [ -d "$HA_CONFIG_DIR" ]; then
    mkdir -p "${HA_CONFIG_DIR}/packages"
    HA_PKG="${HA_CONFIG_DIR}/packages/gridlock.yaml"
    OLD_SUM="$(sha256sum "$HA_PKG" 2>/dev/null | cut -d' ' -f1)" || OLD_SUM=""
    cp /opt/appdaemon/apps/gridlock/ha_support.yaml "$HA_PKG"
    NEW_SUM="$(sha256sum "$HA_PKG" 2>/dev/null | cut -d' ' -f1)" || NEW_SUM=""
    if [ "$OLD_SUM" != "$NEW_SUM" ]; then
        bashio::log.info "packages/gridlock.yaml (watchdog + helpers) installed/updated — reloading HA to apply it."
        # Best-effort: these three reload services re-parse the whole
        # merged configuration.yaml tree (packages included), so a
        # brand-new automation/helper picks up without a full HA
        # restart in the common case. If HA core isn't up yet, or a
        # reload call fails for some other reason, this is silently
        # best-effort — worst case the change applies on HA's next
        # normal restart instead, same as the old manual-copy flow,
        # just without the copying.
        python3 - <<'PYEOF' || true
import json
import os
import urllib.error
import urllib.request

token = os.environ["SUPERVISOR_TOKEN"]
for domain, service in (("automation", "reload"), ("input_boolean", "reload"),
                         ("input_select", "reload")):
    req = urllib.request.Request(
        f"http://supervisor/core/api/services/{domain}/{service}",
        method="POST", data=b"{}",
        headers={"Authorization": f"Bearer {token}",
                 "Content-Type": "application/json"})
    try:
        urllib.request.urlopen(req, timeout=10)
        print(f"Reloaded {domain}.{service}")
    except (urllib.error.URLError, TimeoutError) as exc:
        print(f"Could not reload {domain}.{service}: {exc}")
PYEOF
    fi
else
    bashio::log.warning "HA config directory not mounted (homeassistant_config:rw) — the fail-safe watchdog automation was not installed. Re-approve this add-on's permissions (Info tab) and restart it, or set it up manually per DOCS.md."
fi

# Entity overrides from the add-on's Configuration tab — written as a
# small JSON file gridlock.py reads as an extra fallback source,
# rather than ever touching apps.yaml. Passed to python via env vars
# (not string-interpolated into the script) to avoid any quoting
# issues with whatever a user types into the config form.
for f in ev_charging_override octopus_dispatch_override import_rate_override \
         export_rate_override octopus_saving_events_override \
         load_power_entity_override ev_power_entity_override \
         grid_power_entity_override battery_power_entity_override \
         ssen_postcode_override storm_watch_entity_override \
         inverter_temp_entity_override battery_temp_entity_override \
         daily_export_value_entity_override battery_soh_entity_override \
         discharge_cutoff_entity_override; do
    val="$(bashio::config "$f" 2>/dev/null)" || val=""
    if [ "$val" != "null" ] && [ -n "$val" ]; then
        export "GL_OVR_${f}=${val}"
    fi
done
python3 - "${CONFIG_DIR}" <<'PYEOF' || true
import json
import os
import sys

config_dir = sys.argv[1]
prefix = "GL_OVR_"
overrides = {k[len(prefix):]: v for k, v in os.environ.items() if k.startswith(prefix)}
path = os.path.join(config_dir, "apps", "gridlock", "addon_overrides.json")
with open(path, "w") as f:
    json.dump(overrides, f)
PYEOF

# AppDaemon requires latitude/longitude/elevation/time_zone up front —
# pull them from HA core's own config via the Supervisor API proxy
# rather than hardcoding, with a short retry in case core isn't ready.
# `if ! cmd; then` (not a bare command + separate `$?` check) because
# bashio's `set -o errexit` would otherwise kill the script silently
# the instant this exits non-zero, before the check below ever runs.
if ! python3 - "${CONFIG_DIR}" <<'PYEOF'
import json
import os
import sys
import time
import urllib.error
import urllib.request

config_dir = sys.argv[1]
token = os.environ["SUPERVISOR_TOKEN"]
req = urllib.request.Request(
    "http://supervisor/core/api/config",
    headers={"Authorization": f"Bearer {token}"})

core = None
for attempt in range(12):
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            core = json.load(resp)
        break
    except (urllib.error.URLError, TimeoutError) as exc:
        print(f"Waiting for HA core API ({exc})...", file=sys.stderr)
        time.sleep(5)

if core is None:
    print("Could not reach HA core API after 60s", file=sys.stderr)
    sys.exit(1)

appdaemon_yaml = f"""appdaemon:
  latitude: {core['latitude']}
  longitude: {core['longitude']}
  elevation: {core['elevation']}
  time_zone: {core['time_zone']}
  plugins:
    HASS:
      type: hass
      ha_url: http://supervisor/core
      token: {token}
"""
with open(os.path.join(config_dir, "appdaemon.yaml"), "w") as f:
    f.write(appdaemon_yaml)
PYEOF
then
    bashio::log.error "Failed to fetch HA core config — cannot start AppDaemon."
    exit 1
fi

bashio::log.info "Starting AppDaemon..."
cd "${CONFIG_DIR}" || exit 1
exec appdaemon -c "${CONFIG_DIR}"
